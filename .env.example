# Copy to .env and fill in. docker compose reads it; see docs/self-hosting.md ("Configuration").

# Required. Signing keys are derived from it: `openssl rand -base64 48`.
JWT_SECRET=
# Required. The public URL of the site (emailed links, OAuth callbacks).
APP_BASE_URL=https://heaas.example.com

# Email (verification and password reset). Without SMTP_HOST nothing is sent.
SMTP_HOST=
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=HE Engine <noreply@heaas.example.com>

# OAuth sign-in (optional; both of a pair or neither).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Prometheus scraping of http://127.0.0.1:8080/metrics: `openssl rand -hex 32`.
METRICS_TOKEN=

# Where ./backup.sh puts backups (mounted into the backend at /backups).
BACKUP_DIR=/var/backups/heaas
